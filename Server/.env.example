# Copy to .env and fill in. Never commit .env.
# Supabase: Project -> Connect -> "Session pooler" connection string (works over IPv4, needed for Railway).
# URL-encode special characters in the password (@ -> %40, # -> %23, / -> %2F).
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Signs login tokens. Required; the server refuses to start without it.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<long-random-string>

# The account registered with this email automatically becomes the owner/admin.
ADMIN_EMAIL=<your-email>

# Password reset emails, sent through Resend (resend.com). Optional locally: without a key,
# the reset link is printed in the server terminal instead of being emailed.
RESEND_API_KEY=<resend-api-key>

# Where reset links point. Set this in production (Railway); locally it defaults to http://localhost:5173.
# APP_URL=https://x-penseapp.com
